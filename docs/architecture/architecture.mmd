flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Workflow([Workflow step<br/>with: inputs]):::edge
        Runtime["runtime.ts adapter<br/>@actions packages"]:::edge
        Run["main.ts run()<br/>orchestration"]:::core
        Inputs["inputs.ts<br/>inputs and GateConfig"]:::control
        Workflow --> Runtime --> Run --> Inputs
    end

    subgraph State["Data and state"]
        direction TB
        GitHub([GitHub artifacts<br/>baseline from main]):::edge
        Artifact["artifact.ts<br/>download baseline"]:::core
        Baseline[("Baseline results")]:::data
        Results[("Candidate results<br/>JSONL or JSON")]:::data
        GitHub --> Artifact --> Baseline ~~~ Results
    end

    subgraph Core["Analysis (pure functions)"]
        direction TB
        Parse["parse.ts<br/>records by id"]:::core
        Align["align.ts<br/>pair shared ids"]:::core
        Random["random.ts<br/>seeded Mulberry32"]:::control
        Stats["stats.ts<br/>CI, McNemar, t-test"]:::core
        Analyze["analyze.ts<br/>verdicts and budgets"]:::core
        Gate["Pass or fail<br/>threshold or p-value"]:::control
        Random ~~~ Parse --> Align --> Stats --> Analyze --> Gate
    end

    subgraph Obs["Reports and outputs"]
        direction TB
        Report["report.ts<br/>Markdown, deltas JSON"]:::obs
        Summary["Job summary<br/>and report file"]:::obs
        Comment["comment.ts<br/>opt-in PR comment"]:::obs
        Outputs["Step outputs<br/>passed, deltas"]:::obs
        Report --> Summary ~~~ Comment ~~~ Outputs
    end

    Interfaces -->|paths| State
    State -->|files| Core
    Interfaces -.->|GateConfig| Core
    Core -->|result| Obs
